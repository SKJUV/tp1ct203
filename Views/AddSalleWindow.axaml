<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TP203.ViewModels"
        x:Class="TP203.Views.AddSalleWindow"
        x:DataType="vm:AddSalleViewModel"
        Width="450" Height="400"
        WindowStartupLocation="CenterOwner"
        SystemDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="AcrylicBlur"
        ExtendClientAreaToDecorationsHint="True">

    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource GlassBorderColor}" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
        <Grid RowDefinitions="60, *, 80">
            <!-- Header -->
            <Border Background="#10FFFFFF" Padding="20">
                <Grid ColumnDefinitions="*, Auto">
                    <TextBlock Text="Ajouter une Salle" FontWeight="Bold" FontSize="18"/>
                    <Button Grid.Column="1" Command="{Binding CancelCommand}" Content="✕" Background="Transparent" Foreground="{StaticResource TextDimmedBrush}" Padding="5"/>
                </Grid>
            </Border>

            <!-- Form -->
            <Border Grid.Row="1" Padding="30">
                <StackPanel Spacing="20">
                    <StackPanel Spacing="8">
                    <TextBlock Text="Nom de la salle" FontSize="12" Foreground="{StaticResource TextDimmedBrush}"/>
                    <TextBox Text="{Binding Nom}" Watermark="Ex: Amphi 100"/>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Text="Type" FontSize="12" Foreground="{StaticResource TextDimmedBrush}"/>
                    <ComboBox ItemsSource="{Binding AvailableTypes}" SelectedItem="{Binding Type}" HorizontalAlignment="Stretch"/>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Text="Capacité (Places)" FontSize="12" Foreground="{StaticResource TextDimmedBrush}"/>
                    <NumericUpDown Value="{Binding Capacite}" Minimum="1" Maximum="2000" HorizontalAlignment="Stretch"/>
                </StackPanel>
            </StackPanel>
        </Border>

            <!-- Actions -->
            <Border Grid.Row="2" Background="#05FFFFFF" Padding="20">
                <Grid ColumnDefinitions="*, Auto">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#EF4444" VerticalAlignment="Center" FontSize="12" Margin="0,0,20,0" TextWrapping="Wrap"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="15">
                        <Button Classes="Secondary" Content="Annuler" Command="{Binding CancelCommand}" Width="100" IsEnabled="{Binding !IsBusy}"/>
                        <Button Classes="Primary" Content="Enregistrer" Command="{Binding SaveCommand}" Width="150" IsEnabled="{Binding !IsBusy}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
