<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TP203.ViewModels"
             xmlns:views="using:TP203.Views"
             x:Class="TP203.Views.AdminDashboardView"
             x:DataType="vm:AdminDashboardViewModel">
    
    <Grid ColumnDefinitions="Auto, 4, *">
        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" 
                BorderBrush="{StaticResource GlassBorderColor}" 
                BorderThickness="0,0,1,0"
                MinWidth="85" MaxWidth="300">
            
            <DockPanel Margin="0,20">
                <StackPanel DockPanel.Dock="Top" Spacing="10" Margin="20,0,20,40">
                    <!-- Logo Area -->
                    <Grid ColumnDefinitions="Auto, *">
                        <Border Width="45" Height="45" CornerRadius="12" Background="{StaticResource PrimaryGradient}" HorizontalAlignment="Left">
                            <PathIcon Data="{StaticResource home_regular}" Width="22" Height="22" Foreground="White" />
                        </Border>
                        
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="15,0,0,0">
                            <TextBlock Text="ICT-203" FontSize="18" FontWeight="Bold" TextWrapping="NoWrap"/>
                            <TextBlock Text="System" FontSize="11" Foreground="{StaticResource TextDimmedBrush}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <Button DockPanel.Dock="Bottom" Command="{Binding LogoutCommand}" Classes="Secondary Menu" Margin="15,20" Background="#10EF4444">
                    <StackPanel Orientation="Horizontal" Spacing="15">
                        <PathIcon Data="{StaticResource logout_regular}" Width="20" Height="20" Foreground="#EF4444"/>
                        <TextBlock Text="Déconnexion" VerticalAlignment="Center" Foreground="#EF4444" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>

                <ScrollViewer>
                    <StackPanel Spacing="5" Margin="10,0">
                        <Button Classes="Menu" Command="{Binding NavigateCommand}" CommandParameter="Overview">
                            <StackPanel Orientation="Horizontal" Spacing="15">
                                <PathIcon Data="{StaticResource home_regular}" Width="20" Height="20" />
                                <TextBlock Text="Planning Global" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="Menu" Command="{Binding NavigateCommand}" CommandParameter="Salles">
                            <StackPanel Orientation="Horizontal" Spacing="15">
                                <PathIcon Data="{StaticResource users_regular}" Width="20" Height="20" />
                                <TextBlock Text="Effectifs &amp; Salles" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="Menu" Command="{Binding NavigateCommand}" CommandParameter="Suivi">
                            <StackPanel Orientation="Horizontal" Spacing="15">
                                <PathIcon Data="{StaticResource calendar_regular}" Width="20" Height="20" />
                                <TextBlock Text="Suivi UEs" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="Menu" Command="{Binding NavigateCommand}" CommandParameter="Structure">
                            <StackPanel Orientation="Horizontal" Spacing="15">
                                <PathIcon Data="{StaticResource layer_regular}" Width="20" Height="20" />
                                <TextBlock Text="Dépt &amp; Filières" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Resizer Handle -->
        <GridSplitter Grid.Column="1" Width="4" Background="Transparent" ResizeDirection="Columns"/>

        <!-- Dynamic Content with Transition -->
        <TransitioningContentControl Grid.Column="2" Content="{Binding CurrentSubView}">
            <TransitioningContentControl.PageTransition>
                <CrossFade Duration="0:0:0.3" />
            </TransitioningContentControl.PageTransition>
            <TransitioningContentControl.DataTemplates>
                <DataTemplate DataType="{x:Type vm:AdminOverviewViewModel}">
                    <views:AdminOverviewView />
                </DataTemplate>
                <DataTemplate DataType="{x:Type vm:AdminSallesViewModel}">
                    <views:AdminSallesView />
                </DataTemplate>
                <DataTemplate DataType="{x:Type vm:AdminSuiviViewModel}">
                    <views:AdminSuiviView />
                </DataTemplate>
                <DataTemplate DataType="{x:Type vm:AdminStructureViewModel}">
                    <views:AdminStructureView />
                </DataTemplate>
            </TransitioningContentControl.DataTemplates>
        </TransitioningContentControl>
    </Grid>
</UserControl>
