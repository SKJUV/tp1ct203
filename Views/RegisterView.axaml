<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TP203.ViewModels"
             x:Class="TP203.Views.RegisterView"
             x:DataType="vm:RegisterViewModel">

    <Grid>
        <!-- Background -->
        <Canvas>
            <Ellipse Width="600" Height="600" Fill="#206366F1" Margin="-200,-200,0,0">
                <Ellipse.RenderTransform>
                    <TranslateTransform X="50" Y="50"/>
                </Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse Width="400" Height="400" Fill="#15A855F7" Margin="400,200,0,0"/>
        </Canvas>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="30">
            <!-- Glass Card -->
            <Border Classes="GlassCard" Width="450" Padding="40">
                <StackPanel Spacing="25">
                    <!-- Header -->
                    <StackPanel Spacing="10" HorizontalAlignment="Center">
                        <Border Width="60" Height="60" CornerRadius="15" Background="{StaticResource PrimaryGradient}">
                            <PathIcon Data="{StaticResource users_regular}" Width="30" Height="30" Foreground="White" />
                        </Border>
                        <TextBlock Text="Créer un compte" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" Foreground="White"/>
                        <TextBlock Text="Rejoignez la plateforme académique" Foreground="{StaticResource TextDimmedBrush}" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Form -->
                    <StackPanel Spacing="15">
                        <StackPanel Spacing="5">
                            <TextBlock Text="Email / Login" Foreground="{StaticResource TextBrush}" FontSize="14" Margin="5,0"/>
                            <TextBox Text="{Binding Login}" Watermark="votre@email.com" />
                        </StackPanel>

                        <StackPanel Spacing="5">
                            <TextBlock Text="Mot de passe" Foreground="{StaticResource TextBrush}" FontSize="14" Margin="5,0"/>
                            <TextBox Text="{Binding Password}" PasswordChar="*" Watermark="••••••••" />
                        </StackPanel>

                        <StackPanel Spacing="5">
                            <TextBlock Text="Type d'utilisateur" Foreground="{StaticResource TextBrush}" FontSize="14" Margin="5,0"/>
                            <ComboBox ItemsSource="{Binding AvailableTypes}" SelectedItem="{Binding SelectedType}" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Error Message -->
                    <TextBlock Text="{Binding ErrorMessage}" 
                               Foreground="#EF4444" 
                               HorizontalAlignment="Center" 
                               IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                    <!-- Action Buttons -->
                    <StackPanel Spacing="10">
                        <Button Classes="Primary" 
                                Command="{Binding RegisterCommand}" 
                                IsEnabled="{Binding !IsBusy}"
                                HorizontalAlignment="Stretch">
                            <Panel>
                                <TextBlock Text="S'inscrire" IsVisible="{Binding !IsBusy}"/>
                                <ProgressBar IsIndeterminate="True" Width="20" Height="20" IsVisible="{Binding IsBusy}" Foreground="White"/>
                            </Panel>
                        </Button>
                        
                        <Button Classes="Secondary" 
                                Command="{Binding BackToLoginCommand}" 
                                HorizontalAlignment="Stretch"
                                Content="Retour à la connexion"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
