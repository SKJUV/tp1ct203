<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TP203.ViewModels"
             x:Class="TP203.Views.MobileDashboardView"
             x:DataType="vm:MobileDashboardViewModel">
    
    <Grid RowDefinitions="Auto, *">
        <!-- Top Navigation -->
        <Border Height="70" Background="{StaticResource BgDarkBrush}" BorderBrush="{StaticResource GlassBorderColor}" BorderThickness="0,0,0,1" Padding="20,0">
            <Grid ColumnDefinitions="*, Auto">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Espace Délégué" FontSize="18" FontWeight="Bold"/>
                    <TextBlock Text="ICT-L2 / Amina B." FontSize="12" Foreground="{StaticResource TextDimmedBrush}"/>
                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Button Background="Transparent" Command="{Binding LogoutCommand}">
                        <PathIcon Data="{StaticResource logout_regular}" Width="18" Height="18" Foreground="#EF4444"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="25" Margin="20">
                
                <!-- Current Session & Certification -->
                <HeaderedContentControl>
                    <HeaderedContentControl.Header>
                        <TextBlock Text="SÉANCE EN COURS" FontSize="12" FontWeight="Bold" Margin="0,0,0,10"/>
                    </HeaderedContentControl.Header>
                    
                    <Border Classes="GlassCard" Padding="20">
                        <StackPanel Spacing="15">
                            <Grid ColumnDefinitions="*, Auto">
                                <StackPanel>
                                    <TextBlock Text="{Binding CurrentSeance.UE.Code}" FontSize="24" FontWeight="ExtraBold"/>
                                    <TextBlock Text="{Binding CurrentSeance.Enseignant.Name}" Foreground="{StaticResource AccentPrimaryBrush}"/>
                                </StackPanel>
                                <Border Grid.Column="1" Classes="GlassCard" Background="#10FFFFFF" Padding="10,5" CornerRadius="8" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding CurrentSeance.PlageHoraire}" FontSize="12" FontWeight="Bold"/>
                                </Border>
                            </Grid>

                            <Separator Background="{StaticResource GlassBorderColor}" Height="1"/>

                            <Grid IsVisible="{Binding !IsCertified}">
                                <Button Classes="Primary" Command="{Binding CertifyCommand}" HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <PathIcon Data="{StaticResource lock_regular}" Width="16" Height="16"/>
                                        <TextBlock Text="Certifier la présence du prof"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                            
                            <Border IsVisible="{Binding IsCertified}" Background="#2027AE60" BorderBrush="#27AE60" BorderThickness="1" CornerRadius="10" Padding="15">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <PathIcon Data="{StaticResource lock_regular}" Foreground="#27AE60" Width="16" Height="16"/>
                                    <TextBlock Text="Séance certifiée avec succès" Foreground="#27AE60" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </HeaderedContentControl>

                <!-- Appel Numérique -->
                <HeaderedContentControl>
                    <HeaderedContentControl.Header>
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBlock Text="APPEL NUMÉRIQUE" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="6 Étudiants" FontSize="11" Foreground="{StaticResource TextDimmedBrush}"/>
                        </Grid>
                    </HeaderedContentControl.Header>
                    
                    <Border Classes="GlassCard" Padding="10">
                        <ItemsControl ItemsSource="{Binding Students}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource GlassBorderColor}" BorderThickness="0,0,0,1" Padding="10,15">
                                        <Grid ColumnDefinitions="*, Auto">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                <TextBlock Text="Absences > 30%" IsVisible="{Binding IsAtRisk}" FontSize="10" Foreground="#EF4444"/>
                                            </StackPanel>
                                            <CheckBox Grid.Column="1" IsChecked="{Binding IsPresent}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </HeaderedContentControl>

                <Button Content="Enregistrer l'appel" HorizontalAlignment="Stretch" Padding="15" CornerRadius="12"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
